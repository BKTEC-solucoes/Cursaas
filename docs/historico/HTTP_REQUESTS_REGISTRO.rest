// Exemplos de Requisições HTTP para Testar o Registro de Alunos
// ============================================================
// Copie e cole no Insomnia, Postman ou execute com cURL

// BASE URL (Altere se necessário)
@base_url = http://localhost:8000/api

// ============================================================
// 1. VALIDAR EMAIL DISPONÍVEL
// ============================================================

### Verificar email novo (deve retornar disponivel: true)
GET @base_url/auth/check-email/novo@example.com

### Verificar email existente (caso já esteja registrado)
GET @base_url/auth/check-email/joao@example.com


// ============================================================
// 2. REGISTRAR NOVO ALUNO
// ============================================================

### Registro bem-sucedido (201)
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "João Silva",
  "email": "joao@example.com",
  "senha": "senha123456"
}

### Registro com email diferente (para testar múltiplas vezes)
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "Maria Santos",
  "email": "maria@example.com",
  "senha": "senhaSegura123"
}

### Erro: Email duplicado (400)
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "Outro João",
  "email": "joao@example.com",
  "senha": "outrasenha123"
}


// ============================================================
// 3. VALIDAÇÕES QUE DEVEM FALHAR (422)
// ============================================================

### Erro: Senha muito curta (min 6)
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "Teste",
  "email": "teste@example.com",
  "senha": "123"
}

### Erro: Email inválido
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "Teste",
  "email": "nao-eh-email",
  "senha": "senha123456"
}

### Erro: Nome vazio
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "",
  "email": "teste@example.com",
  "senha": "senha123456"
}

### Erro: Faltam campos
POST @base_url/auth/registro
Content-Type: application/json

{
  "nome": "Teste",
  "email": "teste@example.com"
}


// ============================================================
// 4. LOGIN APÓS SUCESSO NO REGISTRO
// ============================================================

### Login com novo usuário (use email/senha do registro)
POST @base_url/auth/login
Content-Type: application/json

{
  "email": "joao@example.com",
  "senha": "senha123456"
}


// ============================================================
// 5. EXEMPLOS COM cURL
// ============================================================

## VALIDAR EMAIL (GET)
curl -X GET \
  "http://localhost:8000/api/auth/check-email/novo@example.com" \
  -H "Content-Type: application/json"


## REGISTRAR ALUNO (POST)
curl -X POST \
  "http://localhost:8000/api/auth/registro" \
  -H "Content-Type: application/json" \
  -d '{
    "nome": "João Silva",
    "email": "joao@example.com",
    "senha": "senha123456"
  }'


## EMAIL DUPLICADO (POST)
curl -X POST \
  "http://localhost:8000/api/auth/registro" \
  -H "Content-Type: application/json" \
  -d '{
    "nome": "Outro João",
    "email": "joao@example.com",
    "senha": "outrasenha"
  }'


## LOGIN (POST)
curl -X POST \
  "http://localhost:8000/api/auth/login" \
  -H "Content-Type: application/json" \
  -d '{
    "email": "joao@example.com",
    "senha": "senha123456"
  }'


// ============================================================
// 6. RESPOSTAS ESPERADAS
// ============================================================

