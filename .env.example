# =============================================================================
# CURSAAS - Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commite o arquivo .env com senhas reais!
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS MySQL
# Atenção: o host deve ser "db" (nome do serviço Docker), não "localhost"
# -----------------------------------------------------------------------------
DB_ROOT_PASSWORD=senha_root_forte_aqui
DB_NAME=cursaas
DB_USER=cursaas_user
DB_PASSWORD=senha_user_forte_aqui

DATABASE_URL=mysql+pymysql://cursaas_user:senha_user_forte_aqui@db:3306/cursaas

# -----------------------------------------------------------------------------
# JWT - Autenticação
# Gere uma chave forte com: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=troque_por_uma_chave_secreta_forte_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# UPLOAD DE ARQUIVOS
# MAX_FILE_SIZE em bytes (padrão: 500MB = 524288000)
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

# -----------------------------------------------------------------------------
# CORS - Origens permitidas para o frontend
# Em produção, coloque o domínio real do servidor
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# -----------------------------------------------------------------------------
# PRESENÇA
# Percentual mínimo de presença para aprovação (padrão: 75%)
# -----------------------------------------------------------------------------
PERCENTUAL_PRESENCA_MINIMA_PADRAO=75
