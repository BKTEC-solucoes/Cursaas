# =============================================================================
# CURSAAS - Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commite o arquivo .env com senhas reais!
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS MySQL
# Atenção: o host deve ser "db" (nome do serviço Docker), não "localhost"
# -----------------------------------------------------------------------------
DB_ROOT_PASSWORD=senha_root_forte_aqui
DB_NAME=cursaas
DB_USER=cursaas_user
DB_PASSWORD=senha_user_forte_aqui

DATABASE_URL=mysql+pymysql://cursaas_user:senha_user_forte_aqui@db:3306/cursaas

# -----------------------------------------------------------------------------
# JWT - Autenticação
# Gere uma chave forte com: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=troque_por_uma_chave_secreta_forte_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# UPLOAD DE ARQUIVOS
# MAX_FILE_SIZE em bytes (padrão: 500MB = 524288000)
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

# -----------------------------------------------------------------------------
# ENTREGA DE VÍDEO
#
# VIDEO_X_ACCEL delega o envio do arquivo ao nginx (X-Accel-Redirect): a rota
# valida a assinatura e responde só com o header, sem passar o byte pelo Python.
# Exige estar atrás do nginx — o Compose já define isso no serviço `backend`,
# então NÃO ligue aqui: o mesmo .env serve o `uvicorn --reload`, onde o header
# não significa nada e o vídeo chegaria vazio.
#
# VIDEO_URL_TTL_SECONDS é a validade do link assinado. Curto de propósito: a
# assinatura não carrega usuário nem tenant (o `<video src>` não manda header),
# então o TTL é o que limita um link repassado. Precisa cobrir o início da
# reprodução, não a aula toda — o player renova ao recarregar a tela.
# -----------------------------------------------------------------------------
# VIDEO_X_ACCEL=false
VIDEO_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# CORS - Origens permitidas para o frontend
# Em produção, coloque o domínio real do servidor.
# Atrás do nginx o SPA usa caminhos relativos (/api), mesma origem — o CORS só
# importa para o `ng serve` em :4200.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# -----------------------------------------------------------------------------
# LOGIN COM GOOGLE (side-car Node, serviço `backend-node` no Compose)
# O JWT_SECRET do side-car é o próprio SECRET_KEY acima: os dois serviços
# assinam tokens que o outro valida. Não defina um valor diferente.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost

# -----------------------------------------------------------------------------
# PRESENÇA
# Percentual mínimo de presença para aprovação (padrão: 75%)
# -----------------------------------------------------------------------------
PERCENTUAL_PRESENCA_MINIMA_PADRAO=75
